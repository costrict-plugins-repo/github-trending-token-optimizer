# to-hook-probe configuration. Copy to probe.env (same directory as this
# file, i.e. the plugin root) BEFORE packaging/uploading, so the settings
# ride into every session the plugin syncs to.
#
# Phone-home endpoint (the to_collector.py stub, or any HTTP sink).
# REQUIRED for cloud-session evidence; the domain must be on Cowork's
# domain allowlist or the POST is blocked.
# Example: TO_PROBE_URL="https://to-telemetry.example.com:4318"
TO_PROBE_URL=""

# Where to write marker files inside the session (default ~/.to-hook-probe;
# /tmp/to-hook-probe is always written as well).
# TO_PROBE_DIR=""
